{
  "name": "Build, Test & Release",
  "source_platform": "github_actions",
  "source_file": ".github/workflows/release.yml",
  "triggers": [
    {
      "type": "push",
      "branches": [],
      "branches_ignore": [],
      "tags": [
        "v*"
      ],
      "tags_ignore": [],
      "paths": [],
      "paths_ignore": [],
      "schedule": null,
      "inputs": [],
      "source_workflow": null,
      "raw": "push:\n  tags: ['v*']"
    },
    {
      "type": "workflow_call",
      "branches": [],
      "branches_ignore": [],
      "tags": [],
      "tags_ignore": [],
      "paths": [],
      "paths_ignore": [],
      "schedule": null,
      "inputs": [
        {
          "name": "release_tag",
          "required": true,
          "default": null,
          "type": "string"
        }
      ],
      "source_workflow": null,
      "raw": "workflow_call:\n  inputs:\n    release_tag: {required: true, type: string}"
    }
  ],
  "jobs": [
    {
      "name": "build",
      "stage": null,
      "runner": "ubuntu-latest",
      "dependencies": [],
      "artifacts_produced": [
        "dist/"
      ],
      "artifacts_consumed": [],
      "matrix": {
        "axes": {
          "os": [
            "ubuntu-latest",
            "windows-latest",
            "macos-latest"
          ]
        },
        "include": [],
        "exclude": [],
        "fail_fast": false
      },
      "allow_failure": false,
      "condition": null,
      "environment": {},
      "steps": [
        {
          "name": "checkout",
          "type": "action",
          "value": "actions/checkout@v4",
          "with_args": {},
          "condition": null,
          "environment": {},
          "continue_on_error": false,
          "raw_extras": {}
        },
        {
          "name": "build wheel",
          "type": "command",
          "value": "python -m build",
          "with_args": {},
          "condition": null,
          "environment": {},
          "continue_on_error": false,
          "raw_extras": {}
        },
        {
          "name": "upload artifact",
          "type": "action",
          "value": "actions/upload-artifact@v4",
          "with_args": {
            "name": "dist",
            "path": "dist/"
          },
          "condition": null,
          "environment": {},
          "continue_on_error": false,
          "raw_extras": {}
        }
      ],
      "timeout_minutes": null,
      "raw_extras": {}
    },
    {
      "name": "test",
      "stage": null,
      "runner": "ubuntu-latest",
      "dependencies": [
        "build"
      ],
      "artifacts_produced": [],
      "artifacts_consumed": [
        "build"
      ],
      "matrix": null,
      "allow_failure": false,
      "condition": null,
      "environment": {},
      "steps": [
        {
          "name": "download artifact",
          "type": "action",
          "value": "actions/download-artifact@v4",
          "with_args": {
            "name": "dist"
          },
          "condition": null,
          "environment": {},
          "continue_on_error": false,
          "raw_extras": {}
        },
        {
          "name": "run integration tests",
          "type": "command",
          "value": "pytest tests/integration",
          "with_args": {},
          "condition": {
            "expression": "runner.os == 'Linux'",
            "structured": {
              "type": "unparsed"
            }
          },
          "environment": {},
          "continue_on_error": false,
          "raw_extras": {}
        }
      ],
      "timeout_minutes": null,
      "raw_extras": {}
    },
    {
      "name": "release",
      "stage": null,
      "runner": "ubuntu-latest",
      "dependencies": [
        "test"
      ],
      "artifacts_produced": [],
      "artifacts_consumed": [
        "build"
      ],
      "matrix": null,
      "allow_failure": false,
      "condition": null,
      "environment": {
        "RELEASE_ENV": "production"
      },
      "steps": [
        {
          "name": "download artifact",
          "type": "action",
          "value": "actions/download-artifact@v4",
          "with_args": {
            "name": "dist"
          },
          "condition": null,
          "environment": {},
          "continue_on_error": false,
          "raw_extras": {}
        },
        {
          "name": "publish to PyPI",
          "type": "command",
          "value": "twine upload dist/*",
          "with_args": {},
          "condition": null,
          "environment": {
            "TWINE_PASSWORD": "${{ secrets.PYPI_TOKEN }}"
          },
          "continue_on_error": false,
          "raw_extras": {}
        }
      ],
      "timeout_minutes": null,
      "raw_extras": {}
    }
  ],
  "secrets": [
    {
      "name": "PYPI_TOKEN",
      "scope": "job",
      "scope_ref": "release"
    }
  ],
  "environment_variables": [],
  "linked_workflows": [
    {
      "target": "./.github/workflows/build.yml",
      "relationship": "calls"
    }
  ],
  "raw_extras": {}
}
